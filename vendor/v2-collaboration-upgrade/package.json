{
  "name": "@superdoc/v2-collaboration-upgrade",
  "version": "0.1.0-alpha.0",
  "description": "Fail-closed, provider-neutral SuperDoc v1 to v2 collaboration upgrades.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./binary-store": { "types": "./dist/binary-store.d.ts", "import": "./dist/binary-store.js", "require": "./dist/binary-store.cjs" },
    "./y-websocket": { "types": "./dist/y-websocket.d.ts", "import": "./dist/y-websocket.js", "require": "./dist/y-websocket.cjs" },
    "./hocuspocus": { "types": "./dist/hocuspocus.d.ts", "import": "./dist/hocuspocus.js", "require": "./dist/hocuspocus.cjs" },
    "./liveblocks": { "types": "./dist/liveblocks.d.ts", "import": "./dist/liveblocks.js", "require": "./dist/liveblocks.cjs" },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@hocuspocus/provider": ">=2.13.6 <4",
    "superdoc": "^2.8.0 || >=2.18.0-next.11 <2.18.0 || >=2.18.1-next.1 <2.18.1 || >=2.19.0-next.1 <2.19.0",
    "yjs": "^13.6.31",
    "y-websocket": ">=2 <4"
  },
  "peerDependenciesMeta": {
    "@hocuspocus/provider": { "optional": true },
    "y-websocket": { "optional": true }
  },
  "dependencies": {
    "fflate": "0.8.2",
    "happy-dom": "20.4.0",
    "jszip": "3.10.1",
    "superdoc-final-v1": "npm:superdoc@1.44.1",
    "xml-js": "1.6.11",
    "y-protocols": "1.0.7"
  },
  "engines": { "node": ">=20" }
}
